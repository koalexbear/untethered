{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "untethered: Build",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--locked", "-j", "3", "--manifest-path", "${workspaceFolder}/rust-client/Cargo.toml"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "untethered: Run",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/rust-client.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/rust-client.ps1"]
      },
      "problemMatcher": []
    }
  ]
}
